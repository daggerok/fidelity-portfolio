{
  "name": "fidelity-portfolio",
  "version": "1.0.0",
  "description": "Fidelity reports: watchlists, investments, dividends and DRIPs from Portfolio_Positions CSV exports",
  "source": "src/index.html",
  "scripts": {
    "clean": "rimraf -rf dist",
    "prebuild": "npm run clean",
    "build-github-pages": "npm run build -- --public-url=/fidelity-portfolio/",
    "serve": "parcel --no-cache --no-source-maps",
    "build": "parcel build --no-cache --no-source-maps",
    "start": "pm2 start 'npm run serve' --name app",
    "restart": "pm2 restart app",
    "stop": "pm2 kill",
    "logs": "pm2 logs",
    "test": "bun test src",
    "dev": "bun test src --watch",
    "compare": "bun scripts/compare-scio.ts"
  },
  "keywords": [
    "fidelity",
    "csv",
    "dividends",
    "drip",
    "watchlist",
    "parcel",
    "react",
    "bun"
  ],
  "author": "Maksim Kostromin / GitHub: daggerok",
  "license": "MIT",
  "dependencies": {
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "fflate": "0.8.3",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "2.16.4",
    "@tailwindcss/postcss": "4.3.0",
    "@types/bun": "1.4.3",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "parcel": "2.16.4",
    "pm2": "6.0.14",
    "rimraf": "6.1.3",
    "sass": "1.99.0",
    "tailwindcss": "4.3.0"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
